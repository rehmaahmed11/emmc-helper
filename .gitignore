# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Revive working data: dumps, extracted images and the synthetic demo tree are large and
# regenerable (`revive demo --out ...`), so they never belong in the repository.
demo/
*.img
*.bin
*.pac
*.lz4
*.sparse
manifest.json

# The LAB TESTING database: virtual device images, per-device logs and generated reports.
# Regenerable with `python -m revive.lab_testing create ...`, so it stays out of the repo.
lab_devices/

# Per-session handshake dossiers (default --out of `revive intercept`/`identify`).
revive_handshakes/

# Editors / OS
.idea/
.vscode/
.DS_Store
